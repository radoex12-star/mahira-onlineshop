
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mahira-onlineshop",
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-22",
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  },
  "assets": {
    "directory": "./mahira-site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "SUPABASE_URL": "https://mzdczcengkuxgtgajrja.supabase.co"
  }
}

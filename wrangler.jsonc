{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mahira-onlineshop",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-19",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./mahira-site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
